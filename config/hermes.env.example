# Hermes Google Chat — copy to Secret Manager / Cloud Run env (never commit real values)

GOOGLE_CHAT_PROJECT_ID=od-kansiot

# HTTP inbound (default — no Pub/Sub org IAM)
HERMES_CHAT_TRANSPORT=http
GOOGLE_CHAT_HTTP_EVENTS_URL=https://hermes-gateway-….run.app/api/platforms/google_chat/events
GOOGLE_CHAT_HTTP_EVENTS_AUDIENCE=https://hermes-gateway-….run.app/api/platforms/google_chat/events
GOOGLE_CHAT_HTTP_EVENTS_SERVICE_ACCOUNT_EMAIL=chat@system.gserviceaccount.com
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8080

# Pub/Sub inbound (optional — needs org-admin for chat-api-push IAM)
# GOOGLE_CHAT_SUBSCRIPTION_NAME=projects/…/subscriptions/hermes-chat-events-sub

GOOGLE_CHAT_ALLOWED_USERS=user@opendoors.fi,team@opendoors.fi
GOOGLE_CHAT_HOME_CHANNEL=spaces/AAAAxxxxxxxx
GOOGLE_CHAT_BOOTSTRAP_SPACES=spaces/AAAAxxxxxxxx
GOOGLE_CHAT_MAX_MESSAGES=1
GOOGLE_CHAT_MAX_BYTES=16777216

OPENROUTER_API_KEY=
