# Hermes Google Chat — copy to ~/.hermes/.env (never commit real values)
# https://hermes-agent.nousresearch.com/docs/user-guide/messaging/google_chat

GOOGLE_CHAT_PROJECT_ID=od-kansiot
HERMES_CHAT_TRANSPORT=pubsub

# Step 9 — Pub/Sub pull (default)
GOOGLE_CHAT_SUBSCRIPTION_NAME=projects/od-kansiot/subscriptions/hermes-chat-events-sub
GOOGLE_CHAT_SERVICE_ACCOUNT_JSON=/home/hermes-ipad/.hermes/secrets/google-chat-sa.json
GOOGLE_CHAT_ALLOWED_USERS=ipad@info.opendoors.fi,natalia@info.opendoors.fi
GOOGLE_CHAT_MAX_MESSAGES=1
GOOGLE_CHAT_MAX_BYTES=16777216

# HTTP inbound (only if org blocks chat-api-push Pub/Sub IAM)
# GOOGLE_CHAT_HTTP_EVENTS_URL=https://hermes-gateway-….run.app/api/platforms/google_chat/events
# GOOGLE_CHAT_HTTP_EVENTS_AUDIENCE=https://hermes-gateway-….run.app/api/platforms/google_chat/events
# GOOGLE_CHAT_HTTP_EVENTS_SERVICE_ACCOUNT_EMAIL=chat@system.gserviceaccount.com
# API_SERVER_ENABLED=true
# API_SERVER_HOST=127.0.0.1
# API_SERVER_PORT=8080

GOOGLE_CHAT_HOME_CHANNEL=spaces/AAAAxxxxxxxx
GOOGLE_CHAT_BOOTSTRAP_SPACES=spaces/AAAAxxxxxxxx

OPENROUTER_API_KEY=
