[Unit]
Description=Caddy reverse proxy for Hermes Chat tenants
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/caddy run --config /etc/hermes/Caddyfile --adapter caddyfile
Restart=always
RestartSec=3
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
